{
  "name": "tony-hexo-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "validate": "node tools/check-repo-health.cjs",
    "build": "npm run validate && npm run compress:pet-images && hexo generate --config _config.yml,_config.local.yml",
    "build:prod": "npm run validate && npm run compress:pet-images && hexo generate",
    "clean": "hexo clean",
    "server": "hexo server --config _config.yml,_config.local.yml",
    "server:4001": "hexo server -p 4001 --config _config.yml,_config.local.yml",
    "preview": "hexo server -p 4001 --config _config.yml,_config.local.yml",
    "serve:public": "http-server public -p 4002 -c-1",
    "cms:proxy": "cross-env MODE=git decap-server",
    "dev:admin": "concurrently -k -n proxy,hexo -c cyan,magenta \"npm run cms:proxy\" \"npm run server:4001\"",
    "gen:demo": "node tools/gen-demo-posts.cjs",
    "compress:pet-images": "node tools/compress-pet-images.cjs"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "decap-server": "^3.6.0",
    "http-server": "^14.1.1",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.3.0",
    "hexo-server": "^3.0.0"
  }
}
