<article class="post-single inner-wrap">
  <% var _uilb = (site.data.site_ui && site.data.site_ui.labels) || {}; %>
  <% var catName = _uilb.uncategorized || '未分类'; var catPath = ''; var _cf = true; %>
  <% page.categories.each(function (c) { if (_cf) { catName = c.name; catPath = url_for(c.path); _cf = false; } }); %>
  <% function tagToneClass(str) { var h = 0; var s = String(str || ''); for (var i = 0; i < s.length; i++) h = (h + s.charCodeAt(i) * (i + 1)) % 997; return 'tag-tone-' + (h % 3); } %>
  <h1 class="page-title"><%= page.title %></h1>
  <p class="post-meta post-meta--single">
    <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
    <span class="dot">·</span>
    <span class="cat <%= tagToneClass(catName) %>"><% if (catPath) { %><a href="<%= catPath %>"><%= catName %></a><% } else { %><%= catName %><% } %></span>
    <span class="dot">·</span>
    阅读需 <%= Math.max(1, Math.round(strip_html(page.content || '').replace(/\s+/g, '').length / 400)) %> 分钟
    <% if (page.updated && page.date && page.updated.valueOf() - page.date.valueOf() > 86400000) { %>
    <span class="dot">·</span>
    <%= date(page.updated, 'YYYY-MM-DD') %> 更新
    <% } %>
  </p>
  <div class="article-body">
    <%- page.content %>
  </div>
</article>
