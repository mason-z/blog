<%
var _pui = (site.data.site_ui && site.data.site_ui.pets_page) || {};
var _raw = (site.data.pets_timeline && site.data.pets_timeline.entries) ? site.data.pets_timeline.entries : [];
var _entries = _raw.slice().sort(function (a, b) {
  var da = new Date(a.date != null ? a.date : 0).getTime();
  var db = new Date(b.date != null ? b.date : 0).getTime();
  return db - da;
});

function resolvePetPhoto(t) {
  if (!t) return '';
  var f = t.photo && String(t.photo).trim();
  if (!f) return '';
  if (/^https?:\/\//i.test(f)) return f;
  var p = f.replace(/^source\//, '');
  if (!p.startsWith('/')) p = '/' + p.replace(/^\/+/, '');
  return p;
}

function fmtPetDate(d) {
  if (d == null || d === '') return '—';
  var dt = new Date(d);
  if (isNaN(dt.getTime())) return String(d);
  var y = dt.getFullYear();
  var m = dt.getMonth() + 1;
  var day = dt.getDate();
  var hh = dt.getHours();
  var mm = dt.getMinutes();
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  return y + ' 年 ' + m + ' 月 ' + day + ' 日 ' + pad(hh) + ':' + pad(mm);
}
%>
<article class="page-doc inner-wrap pets-page">
  <header class="pets-header">
    <h1 class="page-title"><%= page.title %></h1>
    <% var _desc = page.description || _pui.page_desc; %>
    <% if (_desc) { %>
    <div class="page-desc md-block pets-header__desc"><%- render_md(_desc) %></div>
    <% } %>
  </header>

  <% if (_entries.length === 0) { %>
  <div class="pets-timeline-empty md-block">
    <%- render_md(_pui.empty_hint || '还没有记录。请在后台 **宠物时间轴** 中添加条目（时间、照片与配文）。**单张照片建议 ≤100KB**；若 JPG 偏大，可在仓库根目录执行 `npm run compress:pet-images` 压缩 `source/images/uploads` 内过大的 JPEG。') %>
  </div>
  <% } else { %>
  <ol class="pets-timeline" aria-label="宠物时间轴">
    <% _entries.forEach(function (row) { %>
    <%   var src = resolvePetPhoto(row); %>
    <%   var _iso = ''; if (row.date != null && row.date !== '') { var _dt = new Date(row.date); if (!isNaN(_dt.getTime())) _iso = _dt.toISOString(); } %>
    <li class="pets-timeline__item">
      <div class="pets-timeline__marker" aria-hidden="true"></div>
      <div class="pets-timeline__card">
        <time class="pets-timeline__date"<% if (_iso) { %> datetime="<%= _iso %>"<% } %>><%= fmtPetDate(row.date) %></time>
        <% if (src) { %>
        <figure class="pets-timeline__figure">
          <img class="pets-timeline__img" src="<%- src %>" alt="" loading="lazy" decoding="async" />
        </figure>
        <% } %>
        <% if (row.note && String(row.note).trim()) { %>
        <div class="pets-timeline__note md-block"><%- render_md(row.note) %></div>
        <% } %>
      </div>
    </li>
    <% }); %>
  </ol>
  <% } %>

  <% if (page.content && String(page.content).trim()) { %>
  <div class="article-body pets-footer md-block">
    <%- page.content %>
  </div>
  <% } %>
</article>
