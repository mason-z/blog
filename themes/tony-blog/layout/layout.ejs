<!DOCTYPE html>
<% var _tcmDm = site.data.theme_cms || {}; %>
<% var _dmRawL = (_tcmDm.dark_mode_bg_image != null && String(_tcmDm.dark_mode_bg_image).trim()) ? String(_tcmDm.dark_mode_bg_image).trim() : ''; %>
<% if (!_dmRawL && theme.dark_mode_bg_image != null && String(theme.dark_mode_bg_image).trim()) { _dmRawL = String(theme.dark_mode_bg_image).trim(); } %>
<% var _hasDarkBgAsset = _dmRawL && resolve_upload_url(_dmRawL); %>
<html lang="<%= config.language %>"<%- _hasDarkBgAsset ? ' class="tony-dark-bg-root"' : '' %>>
<head>
  <%- partial('_partial/head') %>
</head>
<body>
  <%- partial('_partial/header') %>
  <main class="app-main">
    <%- body %>
  </main>
  <%- partial('_partial/footer') %>
  <script src="<%- url_for('/js/nav.js') %>"></script>
  <script src="<%- url_for('/js/weather-chip.js') %>" defer></script>
</body>
</html>
