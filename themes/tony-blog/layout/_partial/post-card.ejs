<%
function tagToneClass(str) {
  var h = 0;
  var s = String(str || '');
  for (var i = 0; i < s.length; i++) h = (h + s.charCodeAt(i) * (i + 1)) % 997;
  return 'tag-tone-' + (h % 3);
}
var _uilc = (site.data.site_ui && site.data.site_ui.labels) || {};
var catName = _uilc.uncategorized || '未分类';
var catPath = '';
var catFirst = true;
post.categories.each(function (c) {
  if (catFirst) {
    catName = c.name;
    catPath = url_for(c.path);
    catFirst = false;
  }
});
var excerpt = strip_html(post.excerpt || post.content || '').replace(/\s+/g, ' ').trim();
if (excerpt.length > 220) excerpt = excerpt.slice(0, 220) + '…';
var readMin = Math.max(1, Math.round(strip_html(post.content || '').replace(/\s+/g, '').length / 400));
var upd = post.updated || post.date;
%>
<article class="post-card">
  <div class="post-card__body">
    <h2><a href="<%- url_for(post.path) %>"><% if (Number(post.sticky) > 0) { %><span class="post-card__pinned"><%= _uilc.pinned_label || '置顶' %></span> <% } %><%= post.title %></a></h2>
    <p class="post-meta">
      <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
      <span class="dot">·</span>
      <span class="cat <%= tagToneClass(catName) %>"><% if (catPath) { %><a href="<%= catPath %>"><%= catName %></a><% } else { %><%= catName %><% } %></span>
      <span class="dot">·</span>
      阅读需 <%= readMin %> 分钟
    </p>
    <p class="post-excerpt"><%= excerpt %></p>
  </div>
</article>
