<% var _uim = (site.data.site_ui && site.data.site_ui.meta) || {}; %>
<% var _uil = (site.data.site_ui && site.data.site_ui.labels) || {}; %>
<% var _sn = (site.data.site_name && site.data.site_name.name && String(site.data.site_name.name).trim()) || ''; %>
<% var _siteTitle = _sn || _uim.site_title || config.title %>
<% var _siteDesc = plain_from_md(_uim.site_description || config.description) %>
<%
var _favRaw = (_uim.favicon != null && String(_uim.favicon).trim()) ? String(_uim.favicon).trim() : '';
var _favResolved = _favRaw ? resolve_upload_url(_favRaw) : '';
var _useCustomFavicon = _favRaw && _favResolved;
var _favHref = _useCustomFavicon ? url_for(_favResolved) : url_for('/favicon.ico');
var _favType = 'image/x-icon';
if (_useCustomFavicon) {
  var _favLow = _favRaw.toLowerCase();
  if (/\.jpe?g$/i.test(_favLow)) { _favType = 'image/jpeg'; }
  else if (/\.png$/i.test(_favLow)) { _favType = 'image/png'; }
  else if (/\.webp$/i.test(_favLow)) { _favType = 'image/webp'; }
  else if (/\.gif$/i.test(_favLow)) { _favType = 'image/gif'; }
  else if (/\.svg$/i.test(_favLow)) { _favType = 'image/svg+xml'; }
  else { _favType = 'image/jpeg'; }
}
%>
<% var _tcm = site.data.theme_cms || {}; %>
<% var _dmBgRaw = (_tcm.dark_mode_bg_image != null && String(_tcm.dark_mode_bg_image).trim()) ? String(_tcm.dark_mode_bg_image).trim() : ''; %>
<% if (!_dmBgRaw && theme.dark_mode_bg_image != null && String(theme.dark_mode_bg_image).trim()) { _dmBgRaw = String(theme.dark_mode_bg_image).trim(); } %>
<% var _dmBgResolved = _dmBgRaw ? resolve_upload_url(_dmBgRaw) : ''; %>
<% var _dmBgHref = ''; %>
<% if (_dmBgResolved) { _dmBgHref = /^https?:\/\//i.test(_dmBgResolved) ? _dmBgResolved : url_for(_dmBgResolved); } %>
<% var _gbHead = (page.layout === 'guestbook' && site.data.guestbook && site.data.guestbook.page) ? site.data.guestbook.page : null; %>
<% var _gbHeadTitle = (_gbHead && _gbHead.title && String(_gbHead.title).trim()) || ''; %>
<% var _gbHeadIntro = (_gbHead && _gbHead.intro !== undefined && _gbHead.intro !== null) ? plain_from_md(_gbHead.intro) : ''; %>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="<%- _favHref %>" type="<%= _favType %>" />
<script>
(function () {
  try {
    var stored = localStorage.getItem("tony-theme");
    if (stored !== "light") document.documentElement.setAttribute("data-theme", "dark");
  } catch (e) {
    document.documentElement.setAttribute("data-theme", "dark");
  }
})();
</script>
<title>
<% if (page.layout === 'post') { %>
<%- page.title %> | <%- _siteTitle %>
<% } else if (page.layout === 'page') { %>
<%- page.title %> | <%- _siteTitle %>
<% } else if (page.layout === 'travel') { %>
<%- page.title %> | <%- _siteTitle %>
<% } else if (page.layout === 'guestbook') { %>
<%- _gbHeadTitle || page.title || '留言墙' %> | <%- _siteTitle %>
<% } else if (page.path === 'index.html' || page.path === '') { %>
<%- _siteTitle %>
<% } else if (page.category) { %>
<%= page.category %> | <%- _siteTitle %>
<% } else if (page.tag) { %>
<%= (_uil.head_tag_prefix || '标签：') %><%= page.tag %> | <%- _siteTitle %>
<% } else { %>
<%= (_uil.head_fallback_blog || '博客') %> | <%- _siteTitle %>
<% } %>
</title>
<meta name="description" content="<%= page.layout === 'guestbook' ? (_gbHeadIntro || page.description || _siteDesc) : (page.description || _siteDesc) %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="<%- url_for('/css/style.css') %>" />
<% if (_dmBgHref) { %>
<style id="dark-mode-bg-custom">
  /* 壁纸画在 html 上，避免被 body 纯色盖住；遮罩约半透，否则几乎看不见图 */
  html[data-theme="dark"].tony-dark-bg-root {
    background-color: #12121a;
    background-image: linear-gradient(rgba(12, 12, 18, 0.5), rgba(12, 12, 22, 0.58)), url(<%- JSON.stringify(_dmBgHref) %>);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
  html[data-theme="dark"].tony-dark-bg-root body {
    background: transparent !important;
  }
</style>
<% } %>
<% if (page.layout === 'travel') { %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<% } %>
<% if (page.layout === 'guestbook') { %>
<% var _gbWaline = (site.data.guestbook && site.data.guestbook.waline && site.data.guestbook.waline.serverURL && String(site.data.guestbook.waline.serverURL).trim()); %>
<% if (_gbWaline) { %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@waline/client@3.4.3/dist/waline.css" crossorigin="" />
<% } %>
<% } %>
