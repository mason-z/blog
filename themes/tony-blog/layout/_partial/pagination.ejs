<% if (typeof page.total === 'number' && page.total > 1) { %>
<% var _uip = (site.data.site_ui && site.data.site_ui.labels) || {}; %>
<nav class="pagination" aria-label="<%= _uip.pagination_aria || '分页' %>">
  <% if (page.prev_link) { %>
  <a class="btn btn-ghost" href="<%- url_for(page.prev_link) %>"><%= _uip.pagination_prev || '上一页' %></a>
  <% } %>
  <span class="pagination-meta"><%= page.current %> / <%= page.total %></span>
  <% if (page.next_link) { %>
  <a class="btn btn-ghost" href="<%- url_for(page.next_link) %>"><%= _uip.pagination_next || '下一页' %></a>
  <% } %>
</nav>
<% } %>
