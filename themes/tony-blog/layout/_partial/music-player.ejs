<%
  function trackDisplayTitle(t) {
    var explicit = t.title && String(t.title).trim();
    if (explicit) return explicit;
    var f = t.file && String(t.file).trim();
    var u = t.url && String(t.url).trim();
    var raw = (f || u || '').trim();
    if (!raw) return '音乐';
    var clean = raw.replace(/\\/g, '/').split('?')[0].split('#')[0];
    var segs = clean.split('/').filter(function (s) { return s.length > 0; });
    var last = segs.length ? segs[segs.length - 1] : '';
    if (!last) return '音乐';
    var base = last.replace(/\.[^/.]+$/, '');
    if (base) return base;
    if (last && last[0] !== '.') return last;
    return '音乐';
  }
  function resolveTimelineAudio(row) {
    if (!row) return '';
    var f = row.file && String(row.file).trim();
    var u = row.url && String(row.url).trim();
    if (f) {
      if (/^https?:\/\//i.test(f)) return f;
      var p = f.replace(/^source\//, '');
      if (!p.startsWith('/')) p = '/' + p.replace(/^\/+/, '');
      return p;
    }
    if (u) return u;
    return '';
  }
  function timelineSongTitle(row) {
    if (!row) return '音乐';
    var st = row.song_title && String(row.song_title).trim();
    if (st) return st;
    return trackDisplayTitle({ file: row.file, url: row.url });
  }
%>
<% var mp = site.data.music_player || theme.music_player || {}; %>
<% var tl = (site.data.music_share_timeline && site.data.music_share_timeline.entries) ? site.data.music_share_timeline.entries : []; %>
<% var _sorted = tl.slice().sort(function (a, b) {
  var da = new Date(a.date != null ? a.date : 0).getTime();
  var db = new Date(b.date != null ? b.date : 0).getTime();
  return db - da;
}); %>
<% var headerEntry = null; %>
<% for (var hi = 0; hi < _sorted.length; hi++) {
  var rs = resolveTimelineAudio(_sorted[hi]);
  if (rs) { headerEntry = _sorted[hi]; break; }
} %>
<% var resolved = []; %>
<% if (headerEntry) {
  var playSrc = resolveTimelineAudio(headerEntry);
  resolved.push({ title: timelineSongTitle(headerEntry), url: playSrc });
} %>
<%
  var _updRaw = headerEntry ? headerEntry.date : null;
  var _updStr = '';
  if (_updRaw != null && String(_updRaw).trim() !== '') {
    _updStr = String(_updRaw).trim().replace('T', ' ').replace(/\.\d{3}Z?$/, '').replace(/Z$/, '');
  }
  var _updIso = '';
  if (_updRaw != null && String(_updRaw).trim() !== '') {
    var _u0 = String(_updRaw).trim();
    if (/^\d{4}-\d{2}-\d{2}/.test(_u0)) {
      _updIso = _u0.indexOf('T') > -1 ? _u0.split('.')[0].replace('Z', '') : _u0;
      if (_updIso.indexOf(' ') > -1) _updIso = _updIso.replace(' ', 'T');
    }
  }
%>
<% if (mp.enable && resolved.length) { %>
<div class="music-player-wrap" data-music-player>
  <button type="button" class="music-player__toggle" id="music-player-toggle" aria-label="音乐" aria-expanded="false" aria-controls="music-player-panel" title="音乐">
    <svg class="music-player__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.75"/>
      <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.75"/>
    </svg>
  </button>
  <div class="music-player__panel" id="music-player-panel" hidden role="region" aria-label="音乐播放器">
    <div class="music-player__track" id="music-player-trackname">—</div>
    <% if (_updStr) { %>
    <time class="music-player__updated"<% if (_updIso) { %> datetime="<%= _updIso %>"<% } %> title="与音乐时间轴中最新一条一致">更新 <%= _updStr %></time>
    <% } %>
    <div class="music-player__controls">
      <button type="button" class="music-player__play" id="music-player-play" aria-label="播放">▶</button>
    </div>
    <div class="music-player__seek-row">
      <span class="music-player__time" id="music-player-cur">0:00</span>
      <div class="music-player__seek music-player__seek--bar music-player__seek--readonly" id="music-player-seek" role="progressbar" aria-label="播放进度（仅显示）" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="0" aria-live="polite">
        <div class="music-player__seek-track" aria-hidden="true"></div>
        <div class="music-player__seek-fill" id="music-player-seek-fill"></div>
      </div>
      <span class="music-player__time" id="music-player-dur">0:00</span>
    </div>
    <div class="music-player__vol-row">
      <span class="music-player__vol-ico" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 5L6 9H2v6h4l5 4V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M15.54 8.46a5 5 0 010 7.07M19.07 4.93a9 9 0 010 14.14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <input type="range" class="music-player__vol" id="music-player-vol" min="0" max="1" step="0.05" value="0.06" aria-label="音量" />
    </div>
  </div>
  <audio id="music-player-audio" preload="metadata" playsinline></audio>
</div>
<script type="application/json" id="music-player-data"><%- JSON.stringify({ tracks: resolved }) %></script>
<% } %>
