<section class="categories-page inner-wrap">
  <h1 class="page-title">分类</h1>
  <p class="page-desc">按栏目浏览文章</p>
  <% var _n = 0; site.categories.each(function () { _n++; }); %>
  <% if (_n === 0) { %>
  <p class="page-desc">暂无分类，请在文章 front-matter 中设置 <code>categories:</code>。</p>
  <% } else { %>
  <div class="cat-grid cat-grid--all">
    <% site.categories.each(function (cat) { %>
    <a class="cat-card" href="<%= url_for(cat.path) %>">
      <div class="name"><%= cat.name %></div>
      <div class="count"><%= cat.length %> 篇文章</div>
    </a>
    <% }); %>
  </div>
  <% } %>
</section>
