<%
var _rawCities = (site.data.travel && site.data.travel.cities) ? site.data.travel.cities : [];
var _sortedCities = _rawCities.slice().sort(function (a, b) {
  var pa = a.pinned === true ? 1 : 0;
  var pb = b.pinned === true ? 1 : 0;
  if (pa !== pb) return pb - pa;
  return String(b.date || '').localeCompare(String(a.date || ''));
});
var _travelPin = ((site.data.site_ui && site.data.site_ui.labels && site.data.site_ui.labels.pinned_label) || '置顶');
var _markers = _sortedCities.map(function (c) {
  var row = {
    name: c.name,
    lat: c.lat,
    lng: c.lng,
    date: c.date,
    note: c.note,
    url: c.url,
    pinned: c.pinned === true
  };
  if (c.url) {
    row.href = url_for(c.url);
  }
  return row;
});
%>
<article class="travel-page travel-page--fullscreen">
  <h1 class="sr-only"><%= page.title %></h1>
  <div class="travel-map-stage">
    <div class="travel-map-wrap">
      <div id="travel-map" class="travel-map" role="application" aria-label="中国及旅行城市地图"></div>
    </div>
    <div class="travel-map-ui" aria-hidden="false">
      <% if (page.description) { %>
      <header class="travel-header travel-header--float">
        <div class="page-desc md-block"><%- render_md(page.description) %></div>
      </header>
      <% } %>
      <aside class="travel-sidebar" aria-label="城市列表">
        <ol class="travel-city-list">
          <% _markers.forEach(function (c, i) { %>
          <li class="travel-city-list__item">
            <% if (c.href) { %>
            <a href="<%- c.href %>" class="travel-city-list__btn travel-city-list__btn--link">
              <span class="travel-city-list__primary">
                <% if (c.pinned) { %><span class="travel-city-list__badge"><%= _travelPin %></span><% } %>
                <span class="travel-city-list__name"><%= c.name || '未命名' %></span>
              </span>
              <% if (c.date) { %><span class="travel-city-list__date"><%= c.date %></span><% } %>
            </a>
            <% } else { %>
            <button type="button" class="travel-city-list__btn" data-travel-index="<%= i %>">
              <span class="travel-city-list__primary">
                <% if (c.pinned) { %><span class="travel-city-list__badge"><%= _travelPin %></span><% } %>
                <span class="travel-city-list__name"><%= c.name || '未命名' %></span>
              </span>
              <% if (c.date) { %><span class="travel-city-list__date"><%= c.date %></span><% } %>
            </button>
            <% } %>
            <% if (c.note) { %><span class="travel-city-list__note"><%= c.note %></span><% } %>
          </li>
          <% }); %>
          <% if (_markers.length === 0) { %>
          <li class="travel-city-list__empty">暂无城市，请在 <code>source/_data/travel.yml</code> 或后台「旅行地图」中添加。</li>
          <% } %>
        </ol>
      </aside>
    </div>
  </div>

  <% if (page.content && String(page.content).trim()) { %>
  <div class="article-body travel-notes inner-wrap">
    <%- page.content %>
  </div>
  <% } %>
</article>

<script>window.__TRAVEL_MARKERS = <%- JSON.stringify(_markers) %>;</script>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="<%- url_for('/js/travel-map.js') %>"></script>
