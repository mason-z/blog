<% var _uih = (site.data.site_ui && site.data.site_ui.home) || {}; %>
<% var _tcm = site.data.theme_cms || {}; %>
<section class="landing-page">
  <div class="landing-inner">
    <h1 id="landing-title" class="landing-title"><%= _tcm.landing_title || theme.landing_title || config.title %></h1>
    <div id="landing-lead" class="landing-lead md-block" aria-label="首页引言"><%- render_md(_tcm.landing_lead || theme.landing_lead || config.description) %></div>
  </div>
</section>

<section class="home-shell">
  <h1 class="page-title sr-only"><%= _uih.sr_only_title || '博客' %></h1>
  <div class="home-grid">
    <div class="home-main">
      <p class="home-stats">
        <%= _uih.stat_total_prefix || '文库共' %> <strong><%= site.posts.length %></strong> <%= _uih.stat_unit || '篇' %>
        <span class="dot"><%= _uih.stat_dot || '·' %></span>
        <%= _uih.stat_page_prefix || '本页' %> <strong><%= page.posts.length %></strong> <%= _uih.stat_unit || '篇' %>
      </p>
      <div class="post-list post-list--home">
        <% page.posts.each(function(post){ %>
          <%- partial('_partial/post-card', { post: post }) %>
        <% }); %>
      </div>
      <%- partial('_partial/pagination', { page: page }) %>
    </div>
    <aside class="home-aside" aria-label="<%= _uih.aside_aria_label || '站点侧栏' %>">
      <div class="aside-block">
        <h3><%= _uih.aside_categories_title || '分类' %></h3>
        <div class="aside-cat-pills">
          <% site.categories.each(function(cat){ %>
            <a class="aside-cat-pill" href="<%= url_for(cat.path) %>"><%= cat.name %> <span class="num"><%= cat.length %></span></a>
          <% }); %>
        </div>
      </div>
      <div class="aside-block">
        <h3><%= _uih.aside_latest_title || '最新' %></h3>
        <div class="aside-latest">
          <% site.posts.sort('date', -1).limit(5).each(function(p){ %>
            <a class="aside-latest-item" href="<%- url_for(p.path) %>"><%= p.title %></a>
          <% }); %>
        </div>
      </div>
    </aside>
  </div>
</section>
