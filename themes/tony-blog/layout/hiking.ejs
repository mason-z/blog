<%
var _hui = (site.data.site_ui && site.data.site_ui.hiking_page) || {};
var _raw = (site.data.hiking_timeline && site.data.hiking_timeline.entries) ? site.data.hiking_timeline.entries : [];
var _entries = timeline_sort_entries(_raw);
var _pin = _hui.pinned_label || ((site.data.site_ui && site.data.site_ui.labels && site.data.site_ui.labels.pinned_label) || '置顶');
var _desc = page.description || _hui.page_desc;
var _how = _hui.how_to_hint;
var _empty = _hui.empty_hint;
%>
<article class="page-doc inner-wrap hiking-page">
  <header class="hiking-header">
    <h1 class="page-title"><%= page.title %></h1>
    <% if (_desc) { %>
    <div class="page-desc md-block hiking-header__desc"><%- render_md(_desc) %></div>
    <% } %>
    <% if (_how) { %>
    <div class="hiking-howto md-block"><%- render_md(_how) %></div>
    <% } %>
  </header>

  <% if (_entries.length === 0) { %>
  <% var _defaultEmpty =
    '还没有徒步记录。请在后台侧边栏 **徒步时间轴** 中添加条目（日期、标题、可选照片与正文）。**与博客文章无关**，数据保存在 `source/_data/hiking_timeline.yml`。'; %>
  <div class="music-timeline-empty md-block hiking-empty">
    <%- render_md(_empty || _defaultEmpty) %>
  </div>
  <% } else { %>
  <ol class="music-timeline" aria-label="徒步记录">
    <% _entries.forEach(function (row) { %>
    <% var _title = row.title && String(row.title).trim(); %>
    <% if (!_title) _title = '未命名'; %>
    <% var _iso = ''; if (row.date != null && row.date !== '') { var _dt = new Date(row.date); if (!isNaN(_dt.getTime())) _iso = _dt.toISOString(); } %>
    <% var _w = row.weather && String(row.weather).trim(); %>
    <% var _m = row.mood && String(row.mood).trim(); %>
    <% var _loc = row.location && String(row.location).trim(); %>
    <% var _photo = resolve_upload_url(row.photo); %>
    <li class="music-timeline__item">
      <div class="music-timeline__marker" aria-hidden="true"></div>
      <div class="music-timeline__card">
        <div class="music-timeline__meta">
          <div class="music-timeline__time-row">
            <time class="music-timeline__date"<% if (_iso) { %> datetime="<%= _iso %>"<% } %>><%= fmt_timeline_date(row.date) %></time>
            <% if (row.pinned === true) { %>
            <span class="music-timeline__pinned-badge"><%= _pin %></span>
            <% } %>
          </div>
          <h2 class="music-timeline__song"><%= _title %></h2>
        </div>
        <% if (_w || _m || _loc) { %>
        <div class="music-timeline__tags">
          <% if (_w) { %>
          <span class="music-timeline__pill music-timeline__pill--weather" aria-label="天气"><%= _w %></span>
          <% } %>
          <% if (_m) { %>
          <span class="music-timeline__pill music-timeline__pill--mood" aria-label="心情"><%= _m %></span>
          <% } %>
          <% if (_loc) { %>
          <span class="music-timeline__pill music-timeline__pill--location"><%= _loc %></span>
          <% } %>
        </div>
        <% } %>
        <% if (_photo) { %>
        <div class="hiking-timeline__photo">
          <img src="<%- _photo %>" alt="" loading="lazy" decoding="async" />
        </div>
        <% } %>
        <% if (row.note && String(row.note).trim()) { %>
        <div class="music-timeline__note md-block"><%- render_md(row.note) %></div>
        <% } %>
      </div>
    </li>
    <% }); %>
  </ol>
  <% } %>

  <% if (page.content && String(page.content).trim()) { %>
  <div class="article-body hiking-footer md-block">
    <%- page.content %>
  </div>
  <% } %>
</article>
