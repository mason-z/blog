<%
var _msui = (site.data.site_ui && site.data.site_ui.music_share_page) || {};
var _raw = (site.data.music_share_timeline && site.data.music_share_timeline.entries) ? site.data.music_share_timeline.entries : [];
var _entries = _raw.slice().sort(function (a, b) {
  var da = new Date(a.date != null ? a.date : 0).getTime();
  var db = new Date(b.date != null ? b.date : 0).getTime();
  return db - da;
});

/** 与顶栏播放器一致：未填 song_title 时用文件名（去扩展名）或外链末段 */
function trackDisplayTitleFromFile(t) {
  var explicit = t.title && String(t.title).trim();
  if (explicit) return explicit;
  var f = t.file && String(t.file).trim();
  var u = t.url && String(t.url).trim();
  var raw = (f || u || '').trim();
  if (!raw) return '音乐';
  var clean = raw.replace(/\\/g, '/').split('?')[0].split('#')[0];
  var segs = clean.split('/').filter(function (s) { return s.length > 0; });
  var last = segs.length ? segs[segs.length - 1] : '';
  if (!last) return '音乐';
  var base = last.replace(/\.[^/.]+$/, '');
  if (base) return base;
  if (last && last[0] !== '.') return last;
  return '音乐';
}
function timelineEntrySongTitle(row) {
  if (!row) return '音乐';
  var st = row.song_title && String(row.song_title).trim();
  if (st) return st;
  return trackDisplayTitleFromFile({ file: row.file, url: row.url });
}

function fmtShareDate(d) {
  if (d == null || d === '') return '—';
  var dt = new Date(d);
  if (isNaN(dt.getTime())) return String(d);
  var y = dt.getFullYear();
  var m = dt.getMonth() + 1;
  var day = dt.getDate();
  var hh = dt.getHours();
  var mm = dt.getMinutes();
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  return y + ' 年 ' + m + ' 月 ' + day + ' 日 ' + pad(hh) + ':' + pad(mm);
}
%>
<article class="page-doc inner-wrap music-share-page">
  <header class="music-share-header">
    <h1 class="page-title"><%= page.title %></h1>
    <% var _desc = page.description || _msui.page_desc; %>
    <% if (_desc) { %>
    <div class="page-desc md-block music-share-header__desc"><%- render_md(_desc) %></div>
    <% } %>
  </header>

  <aside class="music-share-live" id="music-share-live" aria-label="当前网络位置实时天气参考">
    <div class="music-share-live__inner">
      <p class="music-share-live__title">当前位置天气（自动 · 仅供参考）</p>
      <p class="music-share-live__explain">根据访问时网络大致定位，与下方时间轴里每条记录的日期无关。静态博客无法在保存时自动写入后台；写新一条时可点按钮复制下面两行，分别粘贴到 Decap 的「天气」「地点」。</p>
      <div class="music-share-live__out" id="music-share-live-out">正在获取当前网络位置的天气…</div>
      <p class="music-share-live__err" id="music-share-live-err" hidden></p>
      <button type="button" class="music-share-live__copy" id="music-share-live-copy" hidden>复制天气与地点（粘贴到后台）</button>
    </div>
  </aside>

  <% if (_entries.length === 0) { %>
  <div class="music-timeline-empty md-block">
    <%- render_md(_msui.empty_hint || '暂无分享记录。可在后台 **音乐分享时间轴** 中添加条目；**天气、心情为可选**，适合在对应栏直接写 emoji（如 ☀️、😌）；**歌曲名可不填**。顶栏播放器会播放**时间轴里最新一条**已上传音频。') %>
  </div>
  <% } else { %>
  <ol class="music-timeline" aria-label="音乐分享时间轴">
    <% _entries.forEach(function (row) { %>
    <%   var title = timelineEntrySongTitle(row); %>
    <%   var _iso = ''; if (row.date != null && row.date !== '') { var _dt = new Date(row.date); if (!isNaN(_dt.getTime())) _iso = _dt.toISOString(); } %>
    <li class="music-timeline__item">
      <div class="music-timeline__marker" aria-hidden="true"></div>
      <div class="music-timeline__card">
        <div class="music-timeline__meta">
          <time class="music-timeline__date"<% if (_iso) { %> datetime="<%= _iso %>"<% } %>><%= fmtShareDate(row.date) %></time>
          <h2 class="music-timeline__song"><%= title %></h2>
        </div>
        <%   var _w = row.weather && String(row.weather).trim(); %>
        <%   var _m = row.mood && String(row.mood).trim(); %>
        <%   var _loc = row.location && String(row.location).trim(); %>
        <%   if (_w || _m || _loc) { %>
        <div class="music-timeline__tags">
          <% if (_w) { %>
          <span class="music-timeline__pill music-timeline__pill--weather" aria-label="天气"><%= _w %></span>
          <% } %>
          <% if (_m) { %>
          <span class="music-timeline__pill music-timeline__pill--mood" aria-label="心情"><%= _m %></span>
          <% } %>
          <% if (_loc) { %>
          <span class="music-timeline__pill music-timeline__pill--location"><%= _loc %></span>
          <% } %>
        </div>
        <% } %>
        <% if (row.note && String(row.note).trim()) { %>
        <div class="music-timeline__note md-block"><%- render_md(row.note) %></div>
        <% } %>
      </div>
    </li>
    <% }); %>
  </ol>
  <% } %>

  <% if (page.content && String(page.content).trim()) { %>
  <div class="article-body music-share-footer md-block">
    <%- page.content %>
  </div>
  <% } %>
</article>
<script src="<%- url_for('/js/music-share-live.js') %>" defer></script>
